# Pooled Postgres URL the app uses at runtime (Neon host ending in -pooler).
DATABASE_URL=

# Direct (unpooled) URL. Prisma migrations use it. Required for `prisma migrate`.
# Without a pooler, set it to the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Dedicated database for integration tests. Never point this at production.
DATABASE_URL_TEST=

# At least 32 characters. Generate it outside the repo. Do not commit the value.
BETTER_AUTH_SECRET=

# Public origin of this app, including the scheme. Example: http://localhost:3000
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# Mailtrap sending API. https://mailtrap.io/api-smtp/sending-setup
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=
MAILTRAP_SENDER_NAME=

# Optional. Webhooks stay disabled until this is set.
WEBHOOK_SECRET=

# Staff inbox for new reports, and the account created by `pnpm admin:create`.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Authorizes the daily cleanup at /api/cron/cleanup. At least 16 characters.
CRON_SECRET=

# Local Ollama for staff question drafts. The model must already be pulled.
# Drafts are saved inactive and are not dealt until you publish them.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional. Pusher Channels pushes "room changed" signals so players update instantly.
# Without these, rooms fall back to polling every second. Create an app at pusher.com.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
