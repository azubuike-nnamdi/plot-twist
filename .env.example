# Postgres connection string. Use the direct Neon URL when transactions and row locks matter.
DATABASE_URL=

# Optional direct connection when DATABASE_URL points at a pooled Neon endpoint.
DATABASE_URL_UNPOOLED=

# Dedicated database for integration tests. Never point this at production.
DATABASE_URL_TEST=

# At least 32 characters. Generate it outside the repo. Do not commit the value.
BETTER_AUTH_SECRET=

# Public origin of this app, including the scheme. Example: http://localhost:3000
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

# Mailtrap sending API. https://mailtrap.io/api-smtp/sending-setup
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=
MAILTRAP_SENDER_NAME=

# Optional. Webhooks stay disabled until this is set.
WEBHOOK_SECRET=

# Staff inbox for new reports, and the account created by `pnpm admin:create`.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Authorizes the daily cleanup at /api/cron/cleanup. At least 16 characters.
CRON_SECRET=
